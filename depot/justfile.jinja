[% if 'donnees-privees' in modules -%]
# Charge .env s'il existe ([[ var_donnees ]]), sans échouer s'il est absent (CI).
set dotenv-load := true
[% endif -%]
set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

# Une commande par ligne : just s'arrête à la première qui échoue et renvoie
# son code de sortie. Ne jamais enchaîner avec `;`, ça masquerait un échec.

# Lint + types + tests. Vert = le projet va bien.
check: lint types test

# Lint et vérification du formatage (sans rien modifier)
lint:
    uv run ruff check .
    uv run ruff format --check .

# Typage[% if not debutant %] strict[% endif %] (cibles définies dans pyproject.toml : src/ et tests/)
types:
    uv run mypy

# Tests
test:
    uv run pytest

# Formatage et corrections automatiques. Ce qui reste à corriger à la main n'arrête pas
# le formatage : `just check` le dit ensuite.
fmt:
    uv run ruff check --fix --exit-zero .
    uv run ruff format .
